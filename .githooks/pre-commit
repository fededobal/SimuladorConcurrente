#!/usr/bin/env sh
# Antes de commitear:
#  1. si se tocó el núcleo Java que va al navegador, el motor tiene que estar regenerado;
#  2. no se commitean archivos basura de macOS ni builds.
staged=$(git diff --cached --name-only --diff-filter=ACMR)

if printf '%s\n' "$staged" | grep -Eq '(__MACOSX/|\.DS_Store$|/target/|/dist/|node_modules/)'; then
  echo "  pre-commit: hay archivos que no van al repo (__MACOSX, .DS_Store, target, dist o node_modules):"
  printf '%s\n' "$staged" | grep -E '(__MACOSX/|\.DS_Store$|/target/|/dist/|node_modules/)' | sed 's/^/    /'
  echo "  Sacalos con: git restore --staged <archivo>"
  exit 1
fi

if printf '%s\n' "$staged" | grep -Eq '^backend/(pom\.xml|src/main/java/ar/edu/unlp/info/simulador/(lang|vm|js)/)'; then
  if ! node scripts/motor-hash.mjs --check; then
    exit 1
  fi
  # La huella ya coincide; falta que el motor regenerado entre al commit. Si TeaVM generó
  # un simulador.js idéntico (por ejemplo, solo cambiaron comentarios) no hay nada que agregar.
  if ! git diff --quiet -- frontend/src/engine/simulador.js frontend/src/engine/simulador.hash; then
    echo "  pre-commit: el motor regenerado tiene cambios que no están en este commit."
    echo "  Agregalo:  git add frontend/src/engine/simulador.js frontend/src/engine/simulador.hash"
    exit 1
  fi
fi
