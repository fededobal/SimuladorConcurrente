<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>ar.edu.unlp.info</groupId>
    <artifactId>simulador-monitores</artifactId>
    <version>0.1.0</version>
    <name>Simulador de Monitores</name>
    <description>Nucleo (lexer + parser + VM) y API REST del simulador de monitores para Programacion Concurrente (UNLP)</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <teavm.version>0.15.0</teavm.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Solo las anotaciones de interop (@JSExport) que usa el puente js/. TeaVM
             aporta su propia implementacion de la biblioteca estandar al compilar. -->
        <dependency>
            <groupId>org.teavm</groupId>
            <artifactId>teavm-jso</artifactId>
            <version>${teavm.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Compila el nucleo a JavaScript para que corra en el navegador, sin backend.
          No corre en el build normal: se invoca a mano con

              mvn -Pweb package

          y deja el modulo generado en frontend/src/engine/, que se commitea (Vercel no
          tiene JDK ni Maven, asi que no puede generarlo en el deploy).
        -->
        <profile>
            <id>web</id>
            <dependencies>
                <!-- Emulacion de la biblioteca estandar que TeaVM usa como classpath al
                     compilar. Solo hace falta para generar el JS, no para el backend. -->
                <dependency>
                    <groupId>org.teavm</groupId>
                    <artifactId>teavm-classlib</artifactId>
                    <version>${teavm.version}</version>
                    <scope>provided</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.teavm</groupId>
                        <artifactId>teavm-maven-plugin</artifactId>
                        <version>${teavm.version}</version>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>compile</goal>
                                </goals>
                                <phase>process-classes</phase>
                                <configuration>
                                    <mainClass>ar.edu.unlp.info.simulador.js.SimuladorJs</mainClass>
                                    <targetDirectory>${project.basedir}/../frontend/src/engine</targetDirectory>
                                    <targetFileName>simulador.js</targetFileName>
                                    <targetType>JAVASCRIPT</targetType>
                                    <jsModuleType>ES2015</jsModuleType>
                                    <optimizationLevel>ADVANCED</optimizationLevel>
                                    <minifying>true</minifying>
                                    <debugInformationGenerated>false</debugInformationGenerated>
                                    <sourceMapsGenerated>false</sourceMapsGenerated>
                                    <sourceFilesCopied>false</sourceFilesCopied>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
