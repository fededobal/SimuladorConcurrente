// Buffer de un dato: productor y consumidor con variables condición
// espera: fin Buffer.dato=5 Buffer.hayDato=false
monitor Buffer {
  int dato = 0;
  boolean hayDato = false;
  cond libre, ocupado;

  procedure depositar(d: in int) {
    while (hayDato) wait(libre);
    dato = d;
    hayDato = true;
    signal(ocupado);
  }

  procedure retirar(r: out int) {
    while (not hayDato) wait(ocupado);
    r = dato;
    hayDato = false;
    signal(libre);
  }
}

process Productor {
  int i = 1;
  while (i <= 5) {
    Buffer.depositar(i);
    write("deposite ", i);
    i++;
  }
}

process Consumidor {
  int x = 0;
  int n = 0;
  while (n < 5) {
    Buffer.retirar(x);
    write("retire ", x);
    n++;
  }
}
