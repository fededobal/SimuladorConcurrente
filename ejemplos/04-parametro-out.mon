// Parámetros out
// espera: fin TOTAL.cant=3
monitor TOTAL {
  int cant = 0;

  procedure incrementar() {
    cant = cant + 1;
  }

  procedure verificar(R: out int) {
    R = cant;
  }
}

process Suma {
  for (int i = 1..3) {
    TOTAL.incrementar();
  }
}

process Chequeo {
  int leido = 0;
  TOTAL.verificar(leido);
  write("leí ", leido);
  TOTAL.verificar(leido);
  write("leí ", leido);
}
