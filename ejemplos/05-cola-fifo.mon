// Cola FIFO dentro del monitor
// espera: fin BufferN.suma=100
monitor BufferN {
  Cola items(int);
  int suma = 0;
  cond noVacio;

  procedure poner(v: in int) {
    push(items, v);
    signal(noVacio);
  }

  procedure sacar() {
    while (empty items) wait(noVacio);
    int x = 0;
    pop(items, x);
    suma = suma + x;
  }
}

process Productor {
  for (int i = 1..4) {
    BufferN.poner(i * 10);
  }
}

process Consumidor {
  for (int i = 1..4) {
    BufferN.sacar();
  }
}
