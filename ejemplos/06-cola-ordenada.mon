// ColaOrdenada
// espera: fin Turnos.primero=1
monitor Turnos {
  ColaOrdenada pendientes;
  int primero = 0;

  procedure cargar() {
    push(pendientes, 3);
    push(pendientes, 1);
    push(pendientes, 2);
  }

  procedure atender() {
    pop(pendientes, primero);
  }
}

process Recepcion {
  Turnos.cargar();
  Turnos.atender();
}
