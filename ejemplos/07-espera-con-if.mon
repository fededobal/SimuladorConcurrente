// Espera con if: un semáforo que falla
// espera: fin Semaforo.s=1
// Ejemplo de la Teoría 4 (simulación de semáforos, primera versión). El proceso despertado
// no vuelve a chequear la condición: con signal and continue, otro pudo entrar antes y
// dejar s en 0. Al ejecutarlo varias veces, en algunas s llega a -1 y hay dos
// trabajadores a la vez en la sección crítica. El ejemplo siguiente lo corrige con while.
monitor Semaforo {
  int s = 1;
  cond pos;

  procedure P() {
    if (s == 0) wait(pos);
    s = s - 1;
  }

  procedure V() {
    s = s + 1;
    signal(pos);
  }
}

process Trabajador[id: 0..4] {
  for (1..3) {
    delay(id);             // trabaja fuera de la sección crítica
    Semaforo.P();
    write("Trabajador ", id, ": entro a la sección crítica");
    delay(1);
    write("Trabajador ", id, ": salgo");
    Semaforo.V();
  }
}
