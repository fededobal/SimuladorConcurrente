{
  "name": "simulador-monitores-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vitepress build docs",
    "docs:dev": "vitepress dev docs --port 5174",
    "docs:build": "vitepress build docs",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "engine": "cd ../nucleo && mvn -q -Pweb -DskipTests package && cd .. && node scripts/motor-hash.mjs --write",
    "smoke": "node ../scripts/smoke-motor.mjs",
    "check": "node ../scripts/motor-hash.mjs --check && npm run lint && npm run test && npm run build && npm run smoke"
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "shiki": "^2.5.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.7",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.7"
  }
}
