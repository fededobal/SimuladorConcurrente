### validos/tuplas-en-push-y-pop
monitor M { Cola c(int, (text, double)); ColaOrdenada o(int, text, double); int k; text s; double d;
  procedure f() { push(c, 1, "a", 2.5); push(c, (2, "b", 3.5)); push(c, (3, ("c", 4.5)));
    pop(c, k, s, d); pop(c, (k, s, d)); pop(c, (k, (s, d)));
    push(o, (k, s, d)); pop(o, k, s, d); if (empty o and not empty(c)) skip; } }
process P { M.f(); }
### validos/decrementos-y-llamada-indexada
monitor M[k: 0..1] { cond c[2]; int a[2]; int n = 0;
  for (int i = 1; i >= 0; i--) { a[i]--; }
  while (n < 2) { n++; }
  procedure f(x: int; r: out int) { a[x]--; n--; r = n; signal(c[x]); if (n == 2.0) skip; } }
process P { int r; M[1].f(0, r); M[0].f(1, r); }
### validos/estilo-c-y-grupos-de-parametros
monitor M { procedure f(int a, b; c, d: in double; e: out bool) { e = a + b < c + d; } }
process P { bool e; M.f(1, 2, 3, 4.5, e); }
